<mxfile host="app.diagrams.net"><diagram id="ticketq" name="TicketQ Architecture"><mxGraphModel dx="1400" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:22px'&gt;TicketQ — Event Booking Architecture&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5D6385'&gt;3-tier (presentation · application · data) + event-driven async processing on AWS&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="60" as="geometry"/></mxCell><mxCell id="cloud" value="AWS Cloud" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#9AA1BD;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontStyle=1;fontColor=#5D6385;" vertex="1" parent="1"><mxGeometry x="215" y="100" width="1185" height="740" as="geometry"/></mxCell><mxCell id="t1" value="PRESENTATION" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#9AA1BD;" vertex="1" parent="1"><mxGeometry x="275" y="318" width="120" height="18" as="geometry"/></mxCell><mxCell id="t2" value="APPLICATION" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#9AA1BD;" vertex="1" parent="1"><mxGeometry x="630" y="318" width="120" height="18" as="geometry"/></mxCell><mxCell id="t3" value="DATA" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#9AA1BD;" vertex="1" parent="1"><mxGeometry x="1015" y="123" width="120" height="18" as="geometry"/></mxCell><mxCell id="t4" value="ASYNC PROCESSING" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#9AA1BD;" vertex="1" parent="1"><mxGeometry x="880" y="543" width="120" height="18" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;──▶ synchronous request / response&lt;br&gt;&lt;font color='#B86E00'&gt;- - ▶ asynchronous message / event&lt;/font&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;① – ⑦ booking flow, in order&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#F7F8FB;strokeColor=#DADDEA;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="300" height="110" as="geometry"/></mxCell><mxCell id="user" value="&lt;b style='font-size:14px'&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;Web browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B1F3B;strokeWidth=2;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="130" height="90" as="geometry"/></mxCell><mxCell id="front" value="&lt;b style='font-size:14px'&gt;Frontend&lt;/b&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;CloudFront + S3&lt;/font&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;Events · My Bookings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F0FF;strokeColor=#3B6FD8;strokeWidth=2;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="250" y="355" width="170" height="100" as="geometry"/></mxCell><mxCell id="apigw" value="&lt;b style='font-size:14px'&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;REST  /api/*&lt;/font&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;HTTPS, throttling&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE8FF;strokeColor=#6D4BD8;strokeWidth=2;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="480" y="360" width="160" height="90" as="geometry"/></mxCell><mxCell id="api" value="&lt;b style='font-size:14px'&gt;Booking API service&lt;/b&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;Events + Bookings logic&lt;/font&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;validation, seat reservation&lt;/font&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;auto-scaled (ECS / Lambda)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE8FF;strokeColor=#6D4BD8;strokeWidth=2;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="700" y="340" width="200" height="130" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b style='font-size:14px'&gt;ElastiCache (Redis)&lt;/b&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;cached event list&lt;/font&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;&amp;amp; seat counts (TTL 30s)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EE;strokeColor=#0B8A62;strokeWidth=2;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="190" height="90" as="geometry"/></mxCell><mxCell id="rds" value="&lt;b style='font-size:14px'&gt;Amazon RDS (PostgreSQL)&lt;/b&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;events, bookings&lt;/font&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;Multi-AZ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F6EE;strokeColor=#0B8A62;strokeWidth=2;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="980" y="360" width="190" height="90" as="geometry"/></mxCell><mxCell id="sqs" value="&lt;b style='font-size:14px'&gt;Amazon SQS&lt;/b&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;booking-events queue&lt;/font&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;(BookingCreated)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1DC;strokeColor=#B86E00;strokeWidth=2;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="700" y="580" width="200" height="90" as="geometry"/></mxCell><mxCell id="lambda" value="&lt;b style='font-size:14px'&gt;AWS Lambda&lt;/b&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;Ticket worker&lt;/font&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;ticket code + email&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1DC;strokeColor=#B86E00;strokeWidth=2;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="980" y="580" width="190" height="90" as="geometry"/></mxCell><mxCell id="ses" value="&lt;b style='font-size:14px'&gt;Amazon SES&lt;/b&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;ticket email&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1DC;strokeColor=#B86E00;strokeWidth=2;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="1230" y="580" width="150" height="90" as="geometry"/></mxCell><mxCell id="dlq" value="&lt;b style='font-size:14px'&gt;Dead-letter queue&lt;/b&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;after 3 failed attempts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7EE;strokeColor=#D6336C;strokeWidth=2;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="700" y="730" width="200" height="70" as="geometry"/></mxCell><mxCell id="cw" value="&lt;b style='font-size:14px'&gt;CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;logs, metrics,&lt;/font&gt;&lt;br&gt;&lt;font color='#5D6385'&gt;alarm on DLQ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F2F6;strokeColor=#5D6385;strokeWidth=2;fontColor=#1B1F3B;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="150" height="90" as="geometry"/></mxCell><mxCell id="cwnote" value="all components → CloudWatch" style="text;html=1;fontSize=11;fontColor=#5D6385;align=left;" vertex="1" parent="1"><mxGeometry x="1225" y="262" width="170" height="20" as="geometry"/></mxCell><mxCell id="e0" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B1F3B;strokeWidth=2;fontColor=#1B1F3B;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" parent="1" source="user" target="front"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="REST / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B1F3B;strokeWidth=2;fontColor=#1B1F3B;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" parent="1" source="front" target="apigw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B1F3B;strokeWidth=2;fontColor=#1B1F3B;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" parent="1" source="apigw" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="① read events (cache-aside)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B1F3B;strokeWidth=2;fontColor=#1B1F3B;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.500;exitY=0.000;entryX=0.000;entryY=0.500;" edge="1" parent="1" source="api" target="redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="195"/></Array></mxGeometry></mxCell><mxCell id="e4" value="② read / reserve seat (SQL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B1F3B;strokeWidth=2;fontColor=#1B1F3B;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" parent="1" source="api" target="rds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="③ publish BookingCreated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B86E00;strokeWidth=2;fontColor=#B86E00;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=7 5;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;" edge="1" parent="1" source="api" target="sqs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="④ trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B86E00;strokeWidth=2;fontColor=#B86E00;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=7 5;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" parent="1" source="sqs" target="lambda"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="⑤ status = CONFIRMED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B1F3B;strokeWidth=2;fontColor=#1B1F3B;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;" edge="1" parent="1" source="lambda" target="rds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="⑥ send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B1F3B;strokeWidth=2;fontColor=#1B1F3B;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" parent="1" source="lambda" target="ses"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="on repeated failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D6336C;strokeWidth=2;fontColor=#D6336C;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=7 5;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;" edge="1" parent="1" source="sqs" target="dlq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="⑦ ticket email to customer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B86E00;strokeWidth=2;fontColor=#B86E00;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=7 5;exitX=0.500;exitY=1.000;entryX=0.500;entryY=1.000;" edge="1" parent="1" source="ses" target="user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1305" y="830"/><mxPoint x="105" y="830"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>